# Copy this to `.env` and fill in real values. `.env` is gitignored — never commit your real keys.

# OpenRouter (primary LLM provider — Claude Haiku 4.5 by default).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override session idle timeout (seconds). Default 1800 (30 min).
# Useful for testing the idle-warning modal without waiting half an hour.
# SESSION_IDLE_TIMEOUT=120

# Optional: enable geo-fencing (requires GeoLite2-Country.mmdb at the project root).
# GEOFENCE_ENABLED=false
# GEOFENCE_ALLOWED_COUNTRIES=BH,IN,KW,AE

# Optional: relax MFA requirement for demos. Default true (production-safe).
# REQUIRE_MFA=false

# ── Real email (SMTP) ─────────────────────────────────────────────────────────
# Default: console backend (prints emails to the dev terminal). To send real
# email for the "admin creates user, temp password emailed" flow, uncomment
# the block below and provide real SMTP credentials.
#
# Gmail SMTP example (easiest for thesis demos — requires a Gmail App Password):
#   1. Enable 2FA on your Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Paste it as EMAIL_HOST_PASSWORD below
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com

# ── Production hardening ──────────────────────────────────────────────────────
# Set DEBUG=False in production. This automatically activates:
#   - SECURE_SSL_REDIRECT (HTTP → HTTPS)
#   - SESSION_COOKIE_SECURE + CSRF_COOKIE_SECURE (HTTPS-only cookies)
#   - HSTS headers (force HTTPS for 1 year)
# Note: requires a real TLS certificate at the deployment layer (Render,
# Railway, fly.io, or self-managed nginx + Let's Encrypt).
#
# DEBUG=false
# DJANGO_ALLOWED_HOSTS=cjpca.example.com
